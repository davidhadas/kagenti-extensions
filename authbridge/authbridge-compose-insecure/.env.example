# Copy to .env and fill in values before running docker compose up.

# ── Local source: token-broker ───────────────────────────────────────────────
# Parent directory of your kagenti-operator checkout. Compose builds the
# token-broker image from ${CODE_DIR}/kagenti-operator/token-broker.
CODE_DIR=/Users/davidhadas/Code

# ── LLM (git-issue + weather agents) ─────────────────────────────────────────
# Ollama running on the host (default). Swap for an OpenAI-compatible URL.
# NOTE: git-issue (CrewAI/LiteLLM) wants a provider-prefixed TASK_MODEL_ID
# (e.g. openai/gpt-4o-mini); weather talks to OpenAI directly and wants a PLAIN
# model name via WEATHER_LLM_MODEL (no prefix).
LLM_API_BASE=http://host.docker.internal:11434
LLM_API_KEY=ollama
TASK_MODEL_ID=ollama_chat/ibm/granite4:latest
# WEATHER_LLM_MODEL=gpt-4o-mini    # plain name for the weather agent (no prefix)

# ── Claude agent (agents/claude.yaml) ─────────────────────────────────────────
# The claude agent drives the Claude Code CLI against a LiteLLM / Anthropic-
# compatible endpoint. ANTHROPIC_AUTH_TOKEN is REQUIRED to use this agent.
ANTHROPIC_AUTH_TOKEN=
# Empty → the CLI uses api.anthropic.com directly; set to your LiteLLM endpoint
# (must be reachable from the container through the authbridge forward proxy).
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=sonnet

# ── Agent images (optional overrides) ─────────────────────────────────────────
# Agents are standard, pre-built images from the agent-examples repo. Each agent
# file defaults to :latest; set these to pin a tag or point at a local build.
# GIT_ISSUE_AGENT_IMAGE=ghcr.io/kagenti/agent-examples/git_issue_agent:latest
# WEATHER_AGENT_IMAGE=ghcr.io/kagenti/agent-examples/weather_service:latest
# CLAUDE_AGENT_IMAGE=ghcr.io/kagenti/agent-examples/claude_agent:latest

# ── GitHub OAuth App ─────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New
#   Homepage URL:            http://localhost:3000
#   Authorization callback URL: http://localhost:8190/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:8190/oauth/callback

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
